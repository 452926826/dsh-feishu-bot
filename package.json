{
  "name": "dsh-feishu-bot",
  "version": "0.1.4",
  "description": "Connect a Feishu bot to DeepSeek Harness projects and conversations",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/452926826/dsh-feishu-bot.git"
  },
  "homepage": "https://github.com/452926826/dsh-feishu-bot#readme",
  "bugs": {
    "url": "https://github.com/452926826/dsh-feishu-bot/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "bot"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.57.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node --check lib/client.js",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "prepack": "npm run check",
    "binding:status": "node scripts/inspect-binding.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT"
}
