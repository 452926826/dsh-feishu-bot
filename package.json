{
  "name": "dsh-feishu-bot",
  "version": "0.1.4",
  "description": "Connect a Feishu bot to DeepSeek Harness projects and conversations",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-user-approval": "*"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.57.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node --check lib/client.js",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "binding:status": "node scripts/inspect-binding.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
